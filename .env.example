# VITE_GEMINI_API_KEY: Required for Gemini AI API calls in standard Vite/local development.
# Copy this file to .env and replace the placeholder with your actual key.
# Obtain a key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_API_KEY: Used by Google AI Studio (injected automatically at runtime from user secrets).
# You do not need to set this for local development; use VITE_GEMINI_API_KEY instead.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
