# ==========================================
# AI Pitch Visualizer - API Keys Configuration
# ==========================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` (do not commit the .env file to GitHub).
# 2. Paste YOUR API key for the provider you want to use.
# 3. You ONLY need to provide ONE of these keys for the app to work.
# 4. Leave the other keys exactly as they are (with their placeholders).

# --- Option 1: Google Gemini (Default & Recommended) ---
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# --- Option 2: OpenAI (GPT-4 / DALL-E 3) ---
VITE_OPENAI_API_KEY="your_openai_api_key_here"

# --- Option 3: Stability AI (Stable Diffusion) ---
VITE_STABILITY_API_KEY="your_stability_api_key_here"

# --- Option 4: Hugging Face ---
VITE_HUGGINGFACE_API_KEY="your_huggingface_api_key_here"
